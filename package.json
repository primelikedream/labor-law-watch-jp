{
  "name": "labore-low",
  "version": "0.1.0",
  "description": "日本の労働関連法制の変更・トピックを収集して要約し、ダッシュボードとメールで発信するアプリ",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "tsx src/fetchAll.ts",
    "digest": "tsx src/digest.ts",
    "digest:daily": "tsx src/digest.ts --period=daily",
    "digest:weekly": "tsx src/digest.ts --period=weekly",
    "serve": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "fast-xml-parser": "^5.11.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.16",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
